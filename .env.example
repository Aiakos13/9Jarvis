# 9Jarvis Environment Configuration

# OpenRouter API key
# Replace the placeholder with your own key in the local .env file.
OPENROUTER_API_KEY=your_api_key_here
# Model request timeouts (milliseconds)
AGENT_REQUEST_TIMEOUT=120000
VISION_REQUEST_TIMEOUT=120000

# Maximum total attempts per model request
AGENT_MAX_ATTEMPTS=2
VISION_MAX_ATTEMPTS=2
